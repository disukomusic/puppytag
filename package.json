{
  "name": "bsky-tagger",
  "displayName": "Bsky tagger",
  "version": "0.0.1",
  "description": "Tag bluesky posts for organization",
  "author": "suko @suko.pet",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "package:chrome": "plasmo package --target=chrome-mv3",
    "package:firefox": "plasmo package --target=firefox-mv3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "bsky-tagger@suko.pet"
      }
    }
  },
  "keywords": [],
  "license": "ISC"
}